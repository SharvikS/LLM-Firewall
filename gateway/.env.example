# Gateway service environment — copy to .env:  cp .env.example .env

# LLM provider API key (Groq, OpenAI, etc.)
GROQ_API_KEY=your-groq-api-key-here

# Admin token — must match ADMIN_TOKEN in the root .env / docker-compose.yml
ADMIN_TOKEN=your-admin-token-here

# Positive API-key auth cache TTL in seconds. Set to 0 to force DB lookup on
# every request; keep short so key revocation propagates quickly.
AUTH_CACHE_TTL_SEC=15
