# Public site URL used for Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://titan.sharvik.tech
NEXT_PUBLIC_TITAN_DASHBOARD_URL=https://app.titan.sharvik.tech
NEXT_PUBLIC_TITAN_GATEWAY_BASE_URL=https://gateway.titan.sharvik.tech/v1

# Optional public links. Payment Links are the easiest no-code Stripe setup:
# Stripe Dashboard -> Products -> create $9.99/mo and $35/mo recurring prices
# -> Payment Links -> paste those URLs here.
NEXT_PUBLIC_TITAN_FREE_URL=https://github.com/SharvikS/LLM-Firewall
NEXT_PUBLIC_TITAN_STARTER_PAYMENT_URL=
NEXT_PUBLIC_TITAN_PRO_PAYMENT_URL=
NEXT_PUBLIC_TITAN_CONTACT_URL=mailto:sharviksutar@gmail.com?subject=TITAN%20Gateway

# Optional Checkout Sessions setup. Use this instead of Payment Links if you want
# the site to create sessions from Stripe recurring Price IDs.
STRIPE_SECRET_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_API_VERSION=2026-02-25.clover

# Hosted activation. Set these on the private server-side environment only.
# The storefront uses them to provision tenant + dashboard user + app API key
# after checkout. Never prefix the admin token with NEXT_PUBLIC_.
TITAN_CLOUD_GATEWAY_URL=https://gateway.titan.sharvik.tech
TITAN_CLOUD_ADMIN_TOKEN=

# Public free signup is disabled unless explicitly enabled. For manual demos or
# internal testing, TITAN_ALLOW_UNPAID_ACTIVATION can bypass Stripe checks.
TITAN_ALLOW_FREE_ACTIVATION=false
TITAN_ALLOW_UNPAID_ACTIVATION=false
