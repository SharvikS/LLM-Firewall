# Public site URL used for Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://titan.sharvik.tech

# Optional public links. Payment Links are the easiest no-code Stripe setup:
# Stripe Dashboard -> Products -> create $9.99/mo and $35/mo recurring prices
# -> Payment Links -> paste those URLs here.
NEXT_PUBLIC_TITAN_FREE_URL=https://github.com/SharvikS/LLM-Firewall
NEXT_PUBLIC_TITAN_STARTER_PAYMENT_URL=
NEXT_PUBLIC_TITAN_PRO_PAYMENT_URL=
NEXT_PUBLIC_TITAN_CONTACT_URL=mailto:sharviksutar@gmail.com?subject=TITAN%20Gateway

# Optional Checkout Sessions setup. Use this instead of Payment Links if you want
# the site to create sessions from Stripe recurring Price IDs.
STRIPE_SECRET_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_API_VERSION=2026-02-25.clover
