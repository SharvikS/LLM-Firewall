{
  "name": "titan-llm-firewall-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "TITAN LLM Firewall — cross-browser DLP extension (React + Vite + Tailwind) for ChatGPT, Claude, Gemini, and Perplexity web UIs.",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/gen-icons.js",
    "lint": "eslint . --ext .js,.jsx",
    "test": "jest",
    "clean": "node -e \"const fs=require('fs');['dist','dist-firefox'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "build": "vite build",
    "build:firefox": "node scripts/make-firefox.js",
    "package": "npm run build && npm run build:firefox && node scripts/zip.js"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@crxjs/vite-plugin": "^2.6.1",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.0",
    "jest": "^29.7.0",
    "tailwindcss": "^4.3.1",
    "vite": "^6.3.6"
  }
}
